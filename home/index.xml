<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Homes on</title><link>https://Kiran-Adhikari.github.io/home/</link><description>Recent content in Homes on</description><generator>Hugo</generator><language>en</language><atom:link href="https://Kiran-Adhikari.github.io/home/index.xml" rel="self" type="application/rss+xml"/><item><title>Home</title><link>https://Kiran-Adhikari.github.io/home/home/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://Kiran-Adhikari.github.io/home/home/</guid><description>&lt;section class="hero" data-reveal&gt;&#10; &lt;canvas class="hero__network" aria-hidden="true"&gt;&lt;/canvas&gt;&#10; &lt;div class="hero__inner"&gt;&#10; &lt;div class="hero__text"&gt;&#10; &lt;div class="eyebrow"&gt;Bioinformatics Scientist&lt;/div&gt;&#10; &lt;h1 class="hero__name"&gt;Kiran Adhikari&lt;/h1&gt;&#10; &lt;p class="hero__intro"&gt;I build production genomics pipelines and machine learning models that turn raw sequencing data into decisions. Day to day, I run &lt;strong&gt;NGS workflows&lt;/strong&gt; for RNA-seq, WGS, metagenomics, and DNA methylation on &lt;strong&gt;Nextflow&lt;/strong&gt;, &lt;strong&gt;Argo&lt;/strong&gt;, and &lt;strong&gt;Kubernetes&lt;/strong&gt;, and apply &lt;strong&gt;deep learning&lt;/strong&gt; to &lt;strong&gt;biomarker discovery&lt;/strong&gt; in liver disease.&lt;/p&gt;&#10; &lt;div class="hero__actions"&gt;&#10; &lt;a class="btn-accent" href="https://Kiran-Adhikari.github.io/about/"&gt;About me&lt;/a&gt;&#10; &lt;a class="btn-outline" href="https://Kiran-Adhikari.github.io/publications/"&gt;Publications&lt;/a&gt;&#10; &lt;a class="hero__social" href="http://www.linkedin.com/in/kiran-adhikari-m1997" target="_blank" rel="noopener" aria-label="LinkedIn"&gt;&lt;i class="icon-linkedin"&gt;&lt;/i&gt;&lt;/a&gt;&#10; &lt;a class="hero__social" href="https://github.com/Kiran-Adhikari" target="_blank" rel="noopener" aria-label="GitHub"&gt;&lt;i class="icon-square-github"&gt;&lt;/i&gt;&lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="hero__photo"&gt;&#10; &#10; &#10; &lt;img src="https://Kiran-Adhikari.github.io/images/profile_hu_d36e4c38c97c1fc4.webp" width="260" height="260" alt="Kiran Adhikari"&gt;&#10; &#10; &#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/section&gt;&#10;&#10;&lt;script&gt;&#10; &#10;(function () {&#10; var canvas = document.querySelector('.hero__network');&#10; if (!canvas || !canvas.getContext) return;&#10; var ctx = canvas.getContext('2d');&#10; var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;&#10; var nodes = [], w = 0, h = 0, raf = null, visible = true;&#10; function color() {&#10; return getComputedStyle(canvas).getPropertyValue('--net').trim() || '59,127,118';&#10; }&#10; function resize() {&#10; var r = canvas.getBoundingClientRect(), dpr = Math.min(window.devicePixelRatio || 1, 2);&#10; w = r.width; h = r.height;&#10; canvas.width = w * dpr; canvas.height = h * dpr;&#10; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);&#10; var count = Math.round(Math.min(70, w * h / 14000));&#10; nodes = [];&#10; for (var i = 0; i &lt; count; i++) {&#10; nodes.push({ x: Math.random() * w, y: Math.random() * h,&#10; vx: (Math.random() - 0.5) * 0.25, vy: (Math.random() - 0.5) * 0.25,&#10; r: 1.2 + Math.random() * 1.8 });&#10; }&#10; }&#10; function draw() {&#10; var c = color(), max = 130;&#10; ctx.clearRect(0, 0, w, h);&#10; for (var i = 0; i &lt; nodes.length; i++) {&#10; var a = nodes[i];&#10; for (var j = i + 1; j &lt; nodes.length; j++) {&#10; var b = nodes[j], dx = a.x - b.x, dy = a.y - b.y, d = Math.sqrt(dx * dx + dy * dy);&#10; if (d &lt; max) {&#10; ctx.strokeStyle = 'rgba(' + c + ',' + (0.22 * (1 - d / max)).toFixed(3) + ')';&#10; ctx.lineWidth = 1;&#10; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();&#10; }&#10; }&#10; ctx.fillStyle = 'rgba(' + c + ',0.55)';&#10; ctx.beginPath(); ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2); ctx.fill();&#10; }&#10; }&#10; function step() {&#10; for (var i = 0; i &lt; nodes.length; i++) {&#10; var n = nodes[i];&#10; n.x += n.vx; n.y += n.vy;&#10; if (n.x &lt; 0 || n.x &gt; w) n.vx *= -1;&#10; if (n.y &lt; 0 || n.y &gt; h) n.vy *= -1;&#10; }&#10; draw();&#10; raf = visible ? requestAnimationFrame(step) : null;&#10; }&#10; resize();&#10; if (still) { draw(); } else { step(); }&#10; window.addEventListener('resize', function () { resize(); if (still) draw(); });&#10; if ('IntersectionObserver' in window &amp;&amp; !still) {&#10; new IntersectionObserver(function (e) {&#10; visible = e[0].isIntersecting;&#10; if (visible &amp;&amp; !raf) step();&#10; }).observe(canvas);&#10; }&#10; &#10; new MutationObserver(function () { if (still) draw(); })&#10; .observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });&#10;})();&#10;&lt;/script&gt;&#10;&#10;&lt;section class="home-section"&gt;&#10; &lt;div class="section-head" data-reveal&gt;&#10; &lt;div&gt;&#10; &lt;div class="eyebrow"&gt;Focus&lt;/div&gt;&#10; &lt;h2&gt;What I work on&lt;/h2&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="focus-grid"&gt;&#10; &lt;div class="focus-card" data-reveal&gt;&#10; &lt;div class="focus-card__icon"&gt;&#10; &lt;svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"&gt;&lt;rect x="3" y="3" width="7" height="7" rx="1.5"/&gt;&lt;rect x="14" y="14" width="7" height="7" rx="1.5"/&gt;&lt;path d="M6.5 10v3.5a2 2 0 0 0 2 2H14"/&gt;&lt;/svg&gt;&#10; &lt;/div&gt;&#10; &lt;h3&gt;Pipelines&lt;/h3&gt;&#10; &lt;p&gt;Designing scalable, reproducible pipelines that process large-scale sequencing data, using Nextflow, Argo, Docker, and Kubernetes across HPC and cloud infrastructure.&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;div class="focus-card" data-reveal&gt;&#10; &lt;div class="focus-card__icon"&gt;&#10; &lt;svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"&gt;&lt;path d="M7 3c0 6 10 6 10 12s-10 6-10 6"/&gt;&lt;path d="M17 3c0 6-10 6-10 12s10 6 10 6"/&gt;&lt;path d="M8.5 7h7M8 12h8M8.5 17h7"/&gt;&lt;/svg&gt;&#10; &lt;/div&gt;&#10; &lt;h3&gt;Biomarkers&lt;/h3&gt;&#10; &lt;p&gt;Applying multi-omics analysis and machine learning to bulk and single-cell transcriptomic data to find disease-associated gene signatures that hold up across patient cohorts.&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;div class="focus-card" data-reveal&gt;&#10; &lt;div class="focus-card__icon"&gt;&#10; &lt;svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"&gt;&lt;circle cx="12" cy="12" r="9"/&gt;&lt;circle cx="12" cy="12" r="5"/&gt;&lt;circle cx="12" cy="12" r="1.2" fill="currentColor"/&gt;&lt;/svg&gt;&#10; &lt;/div&gt;&#10; &lt;h3&gt;Long-term goal&lt;/h3&gt;&#10; &lt;p&gt;To become an independent scientist who integrates molecular and computational research to identify and validate therapeutic targets, advance drug discovery, and develop personalized treatments.&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/section&gt;</description></item></channel></rss>